# ============================================================
# Sahayak AI Teacher — Backend Environment Variables Template
# Copy this file to .env inside backend/ (or root .env)
# ============================================================

# ---------- 1. Database & Persistence (Required) ----------
# Option A: Local SQLite Default:
DATABASE_URL=sqlite:///./sahayak.db

# Option B: Supabase PostgreSQL + pgvector (Production Hackathon / Cloud):
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lesson-media

# ---------- 2. Authentication & Security ----------
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# ---------- 3. LLM Configuration ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

LLM_PROVIDER_ORDER=gemini,groq,anthropic

# ---------- 4. Embedding & Vector RAG ----------
EMBEDDING_PROVIDER=gemini

# ---------- 5. Text-to-Speech ----------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- 6. Speech-to-Text ----------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---------- 7. AI Avatar & Video ----------
AVATAR_PROVIDER=free_avatar
DID_API_KEY=
HEYGEN_API_KEY=
SYNTHESIA_API_KEY=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=r79e1c0369
COLOSSYAN_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=

# ---------- 8. Storage & Port ----------
MEDIA_DIR=generated_media
DOC_STORAGE_DIR=uploaded_docs
PORT=8000
BACKEND_PORT=8000
