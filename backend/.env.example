# ============================================================
# Sahayak AI Teacher — Environment Variables Template
# Copy this file to .env (backend / workspace root) and .env.local (frontend)
# Fill in your own API keys before running the application.
# ============================================================

# ---------- LLM Configuration ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

LLM_PROVIDER_ORDER=gemini,groq,anthropic

# ---------- Embedding & Vector RAG ----------
EMBEDDING_PROVIDER=gemini           # gemini (text-embedding-004) | deterministic (SHA-256 fallback)

# ---------- Text-to-Speech (Multilingual Voice) ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- Speech-to-Text (Student Voice Input) ----------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# ---------- AI Avatar / Video Generation (Free + Paid Providers) ----------
# Options: free_avatar (default zero-cost) | did | heygen | synthesia | tavus | colossyan | replicate | huggingface
AVATAR_PROVIDER=free_avatar

# 1. D-ID API (Photo-to-talking-head video - https://studio.d-id.com)
DID_API_KEY=

# 2. HeyGen API (Photorealistic avatars & digital twins - https://heygen.com)
HEYGEN_API_KEY=

# 3. Synthesia API (Studio classroom AI teachers - https://synthesia.io)
SYNTHESIA_API_KEY=

# 4. Tavus API (Real-time conversational replicas - https://tavus.io)
TAVUS_API_KEY=
TAVUS_REPLICA_ID=r79e1c0369

# 5. Colossyan API (Educational multi-actor video - https://colossyan.com)
COLOSSYAN_API_KEY=

# 6. Replicate API (LivePortrait / SadTalker - https://replicate.com)
REPLICATE_API_TOKEN=

# 7. Hugging Face Inference API (Free AI portrait generation - https://huggingface.co)
HUGGINGFACE_API_KEY=

# Optional: Custom Teacher Photo / Presenter ID
AVATAR_DEFAULT_ID=amy-j37u
TEACHER_IMAGE_URL=


# ---------- Database & Vector Store ----------
DATABASE_URL=sqlite:///./sahayak.db

# Optional Supabase / Postgres & pgvector:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=lesson-media

# Optional Pinecone:
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-teacher-index
PINECONE_HOST=https://your-index-host.pinecone.io

# ---------- Media & Static Storage ----------
MEDIA_DIR=generated_media

# ---------- YouTube Data API (Related Video Grounding) ----------
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=3
YOUTUBE_CACHE_TTL_HOURS=168

# ---------- Frontend / Application URLs ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=generate_a_random_secret_here

# ---------- Backend Server Settings ----------
BACKEND_PORT=8000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish
MAX_UPLOAD_MB=25
LOG_LEVEL=info
