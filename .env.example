# ============================================================
# Sahayak AI Teacher — Unified Environment Variables Template
# Copy this file to:
#   - .env (Backend / Workspace root / Railway / Docker)
#   - frontend/.env.local (Next.js / Vercel deployment)
# ============================================================

# ---------- 1. Database & Persistence (Required) ----------
# Option A: Local SQLite (Zero setup, default for local development)
DATABASE_URL=sqlite:///./sahayak.db

# Option B: Supabase PostgreSQL + pgvector (Production Hackathon / Cloud)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Optional: Direct Supabase Storage / Project Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=lesson-media

# Optional: Pinecone Vector Database
PINECONE_API_KEY=
PINECONE_INDEX=ai-teacher-index
PINECONE_HOST=

# ---------- 2. Authentication & Security (Required in Production) ----------
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. Vercel)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# ---------- 3. LLM Configuration (Provider Cascade) ----------
# Primary: Google Gemini (Free Tier / Paid)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Secondary Fallback: Groq (Fast Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Tertiary Fallback (Optional): Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Fallback Order
LLM_PROVIDER_ORDER=gemini,groq,anthropic

# ---------- 4. Embedding & Vector RAG ----------
# Options: gemini (768-dim text-embedding-004) | deterministic (offline SHA-256 fallback)
EMBEDDING_PROVIDER=gemini

# ---------- 5. Text-to-Speech (Multilingual Voice) ----------
# ElevenLabs (Optional - Falls back to local offline Piper Neural TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------- 6. Speech-to-Text (Voice Q&A) ----------
# Deepgram Nova-2 (Optional - Falls back to keyboard text input)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---------- 7. AI Avatar & Video Generation ----------
# Options: free_avatar (default zero-cost canvas) | did | heygen | synthesia | tavus | colossyan | replicate | huggingface
AVATAR_PROVIDER=free_avatar

# Optional Paid Avatar APIs:
DID_API_KEY=
HEYGEN_API_KEY=
SYNTHESIA_API_KEY=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=r79e1c0369
COLOSSYAN_API_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_KEY=

AVATAR_DEFAULT_ID=amy-j37u
TEACHER_IMAGE_URL=

# ---------- 8. Media & Document Storage Paths ----------
# Mount a persistent volume at /app/data on Railway for persistence across deploys
MEDIA_DIR=generated_media
DOC_STORAGE_DIR=uploaded_docs

# ---------- 9. YouTube Data API Grounding ----------
# Optional - Falls back to direct curated search query URLs
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=3
YOUTUBE_CACHE_TTL_HOURS=168

# ---------- 10. Frontend Configuration (Vercel) ----------
# Client-side base URL pointing to the deployed Railway backend:
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app/api
NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app

# ---------- 11. Backend Server & Port ----------
# Railway automatically injects PORT; fallback is 8000 for local development
PORT=8000
BACKEND_PORT=8000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish,ta,te,bn,es
MAX_UPLOAD_MB=25
LOG_LEVEL=info
